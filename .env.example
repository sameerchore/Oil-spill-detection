# TideTrace Environment Configuration Template
# Copy this file to .env and set your API keys

# Zenodo Personal Access Token (for fetching SAR chips)
ZENODO_TOKEN=your_zenodo_api_token_here
ZENODO_USER_ID=your_zenodo_username

# AISStream.io Live WebSocket API Key
AISSTREAM_API_KEY=your_aisstream_key_here
